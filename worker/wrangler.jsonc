{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freebird",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-26",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },

  "account_id": "349d1bc326ebd8f64abfe827fa61ade4",
  "routes": [{"pattern": "freebird-api.com/*", "zone_name": "freebird-api.com"}],
  "workers_dev": false,
}
